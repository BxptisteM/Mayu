digraph MayuData { graph [rankdir=LR,bgcolor="white",pad="0.25",nodesep="0.38",ranksep="0.62",fontname="DejaVu Sans",label="Mayu · PostgreSQL Data Model (physical foreign keys only)",labelloc=t,fontsize=21,fontcolor="#24263A",splines=polyline,overlap=false]; node [shape=plain,fontname="DejaVu Sans"]; edge [color="#66729B",arrowsize=0.7,penwidth=1.3];
"sources" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#B8C1DC" BGCOLOR="#EFF0FF"><TR><TD BGCOLOR="#D9DEF5" ALIGN="LEFT"><FONT FACE="DejaVu Sans" POINT-SIZE="13"><B>sources</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="DejaVu Sans" POINT-SIZE="10">id UUID PK</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="DejaVu Sans" POINT-SIZE="10">name text</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="DejaVu Sans" POINT-SIZE="10">url text UNIQUE</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="DejaVu Sans" POINT-SIZE="10">type text</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="DejaVu Sans" POINT-SIZE="10">tags text[]</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="DejaVu Sans" POINT-SIZE="10">enabled boolean</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="DejaVu Sans" POINT-SIZE="10">created_at timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="DejaVu Sans" POINT-SIZE="10">updated_at timestamptz</FONT></TD></TR></TABLE>>];
