{
  "name": "mayu",
  "version": "1.0.0",
  "private": true,
  "description": "",
  "main": "dist/index.js",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "commands:register": "tsx src/discord/commands/register.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "drizzle-kit check",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/scripts/seed-sources.ts",
    "collect:test": "tsx src/scripts/collect.ts",
    "editorial:preview": "tsx src/scripts/preview-selection.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "ai:test": "tsx src/scripts/test-summary.ts",
    "publish:test": "tsx src/scripts/test-publication.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BxptisteM/Mayu.git"
  },
  "keywords": [],
  "bugs": {
    "url": "https://github.com/BxptisteM/Mayu/issues"
  },
  "homepage": "https://github.com/BxptisteM/Mayu#readme",
  "license": "MIT",
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.0"
    }
  },
  "dependencies": {
    "discord.js": "^14.27.0",
    "dotenv": "^18.0.7",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "rss-parser": "^3.13.0",
    "vitest": "^5.0.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2"
  }
}
